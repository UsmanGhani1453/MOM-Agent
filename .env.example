# Copy to .env if you want to override defaults (all optional)
MOM_OLLAMA_HOST=http://127.0.0.1:11434
MOM_OLLAMA_MODEL=gemma2:2b
MOM_OLLAMA_NUM_CTX=8192
MOM_WHISPER_MODEL=base
MOM_WHISPER_DEVICE=cpu
MOM_WHISPER_COMPUTE_TYPE=int8
# Optional: organisation name for the PDF header, and signature lines (comma-separated).
# Leave both empty for a plain, generic layout.
MOM_ORG_NAME=
# Optional: only needed if you want fixed spellings for a regular group of people
MOM_ROSTER_FILE=data/roster.json
MOM_SIGNATORIES=
MOM_MAX_UPLOAD_MB=500
MOM_DELETE_AUDIO_AFTER=true
